<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12355B"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 INCOMING GODOWN ORDER 🚨"
        android:textColor="#F4A259"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginTop="48dp"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvOrderNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ORD-000123"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="32sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ramesh Kirana Store"
        android:textColor="#D1D5DB"
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹12,450.00"
        android:textColor="#34D399"
        android:textStyle="bold"
        android:textSize="26sp"
        android:layout_marginTop="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="32dp">

        <!-- Big Accept Button -->
        <Button
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="ACCEPT &amp; PACK (STOP RING)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1F2933"
            android:backgroundTint="#F4A259"
            android:layout_marginBottom="12dp" />

        <!-- Snooze 1 Min Button -->
        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⏰ SNOOZE 1 MINUTE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3B82F6"
            android:layout_marginBottom="12dp" />

        <!-- Mute / Dismiss Button -->
        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Mute Ring"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:backgroundTint="#1F2933" />
    </LinearLayout>

</LinearLayout>

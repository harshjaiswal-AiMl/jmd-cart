<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_call_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">

        <!-- Top Urgency Pill Badge -->
        <TextView
            android:id="@+id/tvOrderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 INCOMING GODOWN DISPATCH 🚨"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_order_badge"
            android:letterSpacing="0.06" />

        <!-- Glowing Circular Order Avatar -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_call_avatar">

            <TextView
                android:id="@+id/tvOrderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📦"
                android:textSize="40sp" />
        </FrameLayout>

        <!-- Main Single Order Card -->
        <LinearLayout
            android:id="@+id/llSingleOrderCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="22dp"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal">

            <!-- Order Number (Prominent Monospace) -->
            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORD-000123"
                android:textColor="#F8FAFC"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="24sp"
                android:letterSpacing="0.04"
                android:gravity="center" />

            <!-- Customer / Party Name -->
            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ramesh Kirana Store"
                android:textColor="#F1F5F9"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="6dp"
                android:gravity="center" />

            <!-- Tap-to-Call Phone Chip -->
            <TextView
                android:id="@+id/tvContactPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 Call: 9876543210"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:background="@drawable/bg_phone_chip" />

            <!-- Packaging Breakdown Card (Cartons & Loose Pieces) -->
            <TextView
                android:id="@+id/tvPackagingSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 4 Cartons • 12 Loose Pieces (Total: 108 Pcs)"
                android:textColor="#93C5FD"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/bg_pack_chip" />

            <!-- Grand Total Paired with Rupee Icon -->
            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹12,450.00"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="32sp"
                android:layout_marginTop="14dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Multi-Orders Container (Populated dynamically when multiple orders exist) -->
        <LinearLayout
            android:id="@+id/llMultiOrdersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <!-- Next in Queue Preview Card (Deprecated / Hidden by default) -->
        <TextView
            android:id="@+id/tvNextOrderPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Flexible Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- High-Impact Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- Primary Big Accept & Pack Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAccept"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="✅ ACCEPT ALL &amp; PACK"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_accept"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp" />

            <!-- Secondary Actions Row: Snooze (5 Min) + Mute Side-by-Side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Snooze Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSnooze"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="⏰ SNOOZE 5 MIN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_snooze"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="8dp" />

                <!-- Mute Ringtone Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDismiss"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🔇 MUTE SOUND"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:background="@drawable/bg_btn_mute"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Hardware Key Shortcut Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Press volume buttons to mute ringtone instantly"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

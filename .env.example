# ============================================================
# JMD Cart — Environment Variable Contract
# Copy to .env for local dev, set in Railway Variables for prod
# NEVER commit real values. NEVER share this file with secrets.
# ============================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idms?schema=public"
# Cloud SQL (production): use unix socket format
# DATABASE_URL="postgresql://appuser:PASSWORD@localhost/jmdcart?host=/cloudsql/PROJECT_ID:asia-south1:INSTANCE_NAME&connection_limit=5&schema=public"

# Auth (generate a secure secret: openssl rand -base64 32)
AUTH_SECRET="CHANGE-IN-PRODUCTION-min-32-chars-use-openssl-rand-base64-32"

# App base URLs (production: set to your real domains with https://)
APP_URL="http://localhost:3000"
MANAGEMENT_URL="http://localhost:3000"

# Host-based routing (PRODUCTION REQUIRED: exact hostnames without https://)
# Leave blank in local dev for all-in-one mode
STOREFRONT_HOST="jmdcart.com"
MANAGEMENT_HOST="management.jmdcart.com"

# First-run setup protection (PRODUCTION REQUIRED if SETUP_TOKEN is set)
# Generate: openssl rand -hex 32
# /setup will only be accessible as /setup?token=<this value>
# Stored ONLY in Railway Variables and local .env.deploy - never in repo
SETUP_TOKEN=""

# File uploads (set to a Railway Volume mount path in production)
# e.g. /data/uploads on Railway with a Volume mounted at /data
UPLOAD_DIR="./public/uploads"

# Timezone (IMPORTANT for IST invoice dates)
TZ="Asia/Kolkata"

# Runtime
NODE_ENV="development"
PORT="3000"
DEFAULT_BRANCH_ID="1"

# Proxy trust (set to 1 on Railway - it runs behind a proxy)
TRUST_PROXY="0"

# Email / SMTP (Mailpit for local dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@jmdcart.com"
